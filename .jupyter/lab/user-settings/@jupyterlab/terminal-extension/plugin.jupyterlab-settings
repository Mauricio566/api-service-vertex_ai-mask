{
    // Terminal
    // @jupyterlab/terminal-extension:plugin
    // Terminal settings.
    // *************************************

    // Close on exit
    // Close the widget when exiting the terminal.
    "closeOnExit": true,

    // Blinking cursor
    // Whether to blink the cursor. Changes require reopening the terminal.
    "cursorBlink": true,

    // Font family
    // The font family used to render text.
    "fontFamily": "ui-monospace, monospace",

    // Font size
    // The font size used to render text.
    "fontSize": 16,

    // Line height
    // The line height used to render text.
    "lineHeight": 1,

    // Treat option as meta key on macOS
    // Option key on macOS can be used as meta key. This enables to use shortcuts such as option + f to move cursor forward one word
    "macOptionIsMeta": false,

    // Paste with Ctrl+V
    // Enable pasting with Ctrl+V.  This can be disabled to use Ctrl+V in the vi editor, for instance.  This setting has no effect on macOS, where Cmd+V is available
    "pasteWithCtrlV": true,

    // Screen Reader Mode
    // Add accessibility elements for use with screen readers.
    "screenReaderMode": false,

    // Scrollback Buffer
    // The amount of scrollback beyond initial viewport
    "scrollback": 1000,

    // Show the status bar item
    // Whether to show the running terminals item in the status bar
    "showStatusBarItem": "if-any",

    // Shut down on close
    // Shut down the session when closing the terminal.
    "shutdownOnClose": false,

    // Theme
    // The theme for the terminal.
    "theme": "inherit"
}